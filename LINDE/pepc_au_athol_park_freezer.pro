%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,90,line)


   , or([

    generic_horizontal_details( [ [ `TOTAL` ], currency, w, tab ] )

      
    % currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)
    
    ,or([
    
      [ `Total`, tab, `$`]
      
     
      
     ,[`Grand`, `Total`, tab, `$`]

    , generic_item( [ currency, `USD` ] )

    ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    
    q(0,50,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4

   
   ,q(0,1,line)

   ,line_suppadd_line_5


    
] ).


%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   
     q0n(anything)

    
    ,or([

     read_ahead( [`APF`, `Cold` ] )

    ] )

    ,trace( [ `Found SUPPLIER Line`] )

    , generic_item( [ supplier_party, s1, newline] )

] ).



%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================
   
    generic_item( [ dummy_sup_line, s, tab ] )

    , generic_item( [ dummy_sup_line_1, s, tab ] )    

    , generic_append( [ supplier_party, s1, newline, ` `, ``  ] )

] ).

%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================
   
     generic_item( [ dummy_sup_line_2, s, tab ] )

    , generic_item( [ supplier_address_line, s,[q10(tab), check(supplier_address_line(end) < 419)] ] )

    , generic_item( [ supplier_city, w  ] )

    , generic_item( [ supplier_state, w, newline  ] )

] ).

%=======================================================================
i_line_rule( line_suppadd_line_3, [
%=======================================================================
   
     generic_item( [ dummy_sup_line_2, s, tab ] )

    , generic_item( [ supplier_postcode, s1, newline ] )

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,150,line)

   , line_add_line

   , q(0,1,line)

   , line_add_line_1

   , q(0,1,line)

   , line_add_line_2

   , q(0,1,line)

   , line_add_line_3
   
   , q(0,1,line)

   , line_add_line_4

   , q(0,1,line)

   , line_add_line_5

   , q(0,1,line)
 
   , line_add_line_6     


    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    q0n(anything)

    , read_ahead([ `The`, `Smiths` ] )

    , trace( [ `Found BUYER ADDDRESS line`] )

    ,generic_item( [ buyer_party, s1 ,tab ] )

  
] ).


%=======================================================================
i_line_rule( line_add_line_1,  [
%=======================================================================

     
     generic_item( [buyer_address_line_dummy, s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line_2,  [
%=======================================================================

     
     generic_item( [buyer_address_line, s1, newline ] )

] ).



%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

     generic_item( [ buyer_city, w ] )

    , generic_item( [ buyer_state, w ] )

    , generic_item( [buyer_postcode, s, tab  ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER BANK ACCOUNT NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_bank_accountnumber, [
%=======================================================================
    last_line

    ,q(0,50,up)

    , generic_horizontal_details( [ [`BSB`, `:` ],  supplier_bank_code_raw,s, newline ] )

    
     , check( supplier_bank_code_raw = CodeRaw )

    , trace( [ `supplier_account_ Code_raw` , CodeRaw ] )

    , check(string_string_replace( CodeRaw, ` `, ``, Codestrip ))

    , trace( [ `ACCount  Code Stripped Space` , Codestrip ] )

    , supplier_bank_code(Codestrip)

     , q(0,1,line)

    , generic_horizontal_details( [ [ `Account`, `:` ],  supplier_bank_account_number_raw,s, newline ] )


     , check( supplier_bank_account_number_raw = ACCRaw )

    , trace( [ `supplier_account_raw` , ACCRaw ] )

    , check(string_string_replace( ACCRaw, ` `, ``, ACCstrip ))

    , trace( [ `ACCount  Stripped Space` , ACCstrip ] )

    , supplier_bank_account_number(ACCstrip)



] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
