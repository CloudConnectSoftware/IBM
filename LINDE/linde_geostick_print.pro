% TOTAL NET AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_net, [
%=======================================================================

   q(0,200, line )

   , set(reverse_punctuation_in_numbers)

   , set(regexp_cross_word_boundaries)
 
   , generic_horizontal_details( [ [`Total`, `amount`, `without`, `VAT`, `:`, tab ], total_net,d, newline ] )

   , clear(regexp_cross_word_boundaries)
 
   , clear(reverse_punctuation_in_numbers) 

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL VAT AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_vat, [
%=======================================================================

    q(0,200, line )

   , set(reverse_punctuation_in_numbers)

   , set(regexp_cross_word_boundaries)

   , generic_horizontal_details( [ [ `Output`, `Tax`, tab, generic_item( [ default_vat_rate, d ] ), `,`, `00`, `%`, tab , dummy_num(d), tab ], total_vat,d , newline ] )
 
   , clear(regexp_cross_word_boundaries)
 
   , clear(reverse_punctuation_in_numbers)
] ).

