% SUPPLIER BANK ACCOUNT NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_bank_accountnumber, [
%=======================================================================

     q0n(line)

    , generic_horizontal_details( [ [`Iban`, `:` ], supplier_iban, s1, tab ] )

    , q(0,1,line)

    , generic_horizontal_details( [ [`Bic`, `/`, `Swift`, `:`], supplier_swift_code, s1, tab ] )



] ).


