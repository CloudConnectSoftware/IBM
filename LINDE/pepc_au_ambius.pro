i_rule( get_invoice_number, [
%=======================================================================
    
	q(0,130,line)
	
    , generic_vertical_details( [ [  `Invoice`, `No`, `:`,  newline ], `No`, q(0,1), (start, 10, 300), invoice_number, d, newline ] )

] ).

