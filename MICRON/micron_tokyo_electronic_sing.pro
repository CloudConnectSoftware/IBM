i_version(micron_tokyo_electronic_sing, `25 November, 2019` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( _ ).

i_trace_lists.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    
      get_supplier_detail

    , get_bill_to

    , get_ship_to

    ,get_delivery_note_number
      
    , get_supplier_address

    , get_buyer_address 

    , get_buyer_address_1

    , get_currency

    , get_bank_accountnumber
                    
    , get_invoice_number
    
    , get_invoice_date

    , get_order_number

    , get_total_net

    , get_total_vat

    , get_local_total_vat

    , get_total_invoice

    , get_exchange_rate

    , get_invoice_lines

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

    sender_name( `Tokyo Electron Singapore Pte. Ltd.` )

    , supplier_party( `Tokyo Electron Singapore Pte. Ltd.` )

   , bill_from(`Tokyo Electron Singapore Pte. Ltd.`)

   , supplier_vat_number(`201208006G`)

   , swiss_supplier_country(`SGP`)

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

     q(0,5,line)

   , line_add_line

   , q(0,1,line)

   , line_add_line_2

   , q(0,1,line)

   , line_add_line_3

] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================
    q0n(anything)

    ,  read_ahead([`Tokyo`])

    , trace( [ `Found address`] )

    , generic_item( [ swiss_supplier_name, s1, newline ] )  

   
] ).

%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

      generic_item( [ swiss_supplier_address_1, s1, newline ] )  

       
] ).

%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================

      generic_item( [ swiss_supplier_address_2, s1, newline ] )  

       
] ).




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% BUYER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_address, [
%=======================================================================

     q(0,25,line)

   , line_b_add_line0

   , q(0,2,line)

   , line_b_add_line1

   , q(1,2,line)

   , line_b_add_line2

    , q(0,1,line)

   , line_b_add_line3

  
] ).

%=======================================================================
i_line_rule( line_b_add_line0, [
%=======================================================================
    
    q0n(anything)

     , read_ahead([`MICRON`])

    , trace( [ `Found address`] )
    
    ,  generic_item( [bill_to , `MICRON SEMICONDUCTOR ASIA OPERATIONS PTE.LTD.` ] )

  
       
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% DELIVERY NOTE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_delivery_note_number, [
%=======================================================================

q(0,100,line)


   , generic_vertical_details( [ [ `Remarks`, newline ], `Remarks`, q(1,2), (end,30,30), delivery_note_number, w, `/` ] )

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SHIP TO
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_ship_to, [
%=======================================================================

     q(0,20,line)

    , or([

     generic_horizontal_details( [ [  `SHIP`, `TO`,q10(tab), `:`,q10(tab) ], ship_to, s1, tab ])
      
    ])

    , q(0,1,line)

    , line_ship_to_line_2

] ).

%=======================================================================
i_line_rule( line_ship_to_line_2, [
%=======================================================================
    
    
     q0n(anything)

    , or([ read_ahead([ `OPERATIONS`]), read_ahead([`ASIA`]) ])
     
    , or([
         generic_append( [ ship_to_raw, s1, tab, ` `, ``  ] )

    ])

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

     q(0,25,line)

     , or([
       
    generic_horizontal_details( [ [ `Inv`, `No`, `.`, tab ],  invoice_number, d,  newline ] )

    
     ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

      q(0,20,line)

    , or([ 
        
      generic_horizontal_details( [ [ `Inv`, `Date`, q10(tab) ],  invoice_date , date, newline ] )
    
    ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ORDER NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_order_number, [
%=======================================================================

     q(0,100,line)

    ,or([
       
        find_order_number

   ])

] ).
 
%=======================================================================
i_line_rule_cut( find_order_number, [
%=======================================================================

    q0n(anything)

    , or([
        
    generic_item( [ order_number , [ begin, q(dec("4"),1,1) , q(dec("5"),1,1) , q(dec,8,10) , end ] ] )

    ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INVOICE NET AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_net, [
%=======================================================================
   
    q0n(line)

   , or([

     check_text(`Subtotal`)

   ])

   , or([
       
    generic_horizontal_details( [ [ `Sub`,`total`, `:`, tab ],  total_net, d,  newline ] )

   ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INVOICE VAT AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_vat, [
%=======================================================================
   
   q(0,100,line)

   , check_text(`GST`)

   , or([
       
    generic_horizontal_details( [ [  `GST`, `:`, tab ],  total_vat, d,  newline ] )
       
   ])

      ,  check( total_vat = TotVat)

      , generic_item( [ line_vat_amount , TotVat ] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INVOICE LOCAL VAT AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_local_total_vat, [
%=======================================================================
   
   q(0,100,line)

   , check_text(`Tax`)

   , or([
       
   
    generic_horizontal_details( [ [ `Tax`, `@`, `7`, `.`, `00`, `=`, `(`, `JPY`, `)`, a(d), `@`, `.`, a(d), `=`, `(`, `SGD`, `)`], total_local_vat, d, tab ] )
   
    %,  generic_item( [ default_vat_rate, `7` ] ) 
    

   ])

   

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INVOICE AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_invoice, [
%=======================================================================
   
    q0n(line)

  , check_text(`Grand`)  

   , or([
       
    generic_horizontal_details( [ [ `Grand`, `Total`, `:`, tab ],  total_invoice, d,  newline ] )
      
   ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% EXCHANGE RATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_exchange_rate, [
%=======================================================================
  
    q(0,100,line)

    , set(regexp_cross_word_boundaries)

   ,  get_exchange_rate_line

   , set(regexp_cross_word_boundaries)

] ).

%=======================================================================
i_line_rule(get_exchange_rate_line, [
%=======================================================================
  
    q0n(anything)

   ,  `Tax`, `@`, `7`, `.`, `00`, `=`, `(`, `JPY`, `)`, a(d), `@`

    , generic_item( [ exchange_rate, d, [ `=`, `(`, `SGD`, `)`] ]  ) 

    , trace( [ exchange_rate ] ) 

    , generic_item( [ total_local_vat, d, [tab] ]  ) 

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% CURRENCY
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_currency, [
%=======================================================================
  
    q(0,200,line)

  , or([ check_text(`Unit`) ])  

   , or([

   generic_horizontal_details( [ [ `Unit`, `Price`, q10(tab) ], currency, w , newline ] )
   ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER BANK ACCOUNT NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_bank_accountnumber, [
%=======================================================================
    
     q(0,250,line)

    , with( invoice, currency, Currency )

     , generic_horizontal_details( [ [ `Bank`, `Name`, `:`],  supplier_bank_name, s1, newline ] )

     , q(1,2,line)

     , generic_horizontal_details( [ [`Swift`, `Code`, `:`],  supplier_bank_swift, w, tab ] )

     , q(0,2,line)

     ,or([

         [ check( Currency = `SGD` ) , generic_horizontal_details( [ [ `SGD`, `Account`, `No`, `.`, `:`],  supplier_bank_account_number, w, tab ] ) ]

        , [ check( Currency = `EUR` ) , generic_horizontal_details( [ [ `EUR`, `Account`, `No`, `.`, `:`],  supplier_bank_account_number, w, tab ] ) ]

         , [ check( Currency = `JPY` ) , generic_horizontal_details( [ [ `JPY`, `Account`, `No`, `.`, `:`],  supplier_bank_account_number, w, newline ] ) ]

         , [ check( Currency = `USD` ) , generic_horizontal_details( [ [ `EUR`, `Account`, `No`, `.`, `:`],  supplier_bank_account_number, w, newline ] ) ]   
     ])

     
] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

    , or([

     [ line_invoice_line, line_invoice_line_1 ]

    , line

        ])

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================

     or([
        
        [`DO`, `/`, `PO`, `Number`, `/`, `SO`, `Number`, tab, `Code`, tab, `Amount`,  newline]

       ])  

      , trace( [ `Found Start line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
 
    or([

          [`Item`, `Product`, `Code`, tab, `Description`, tab, `U`, `/`, `M`, tab, `Qty`, tab, `Tax`, tab, `Unit`, `Price`, tab, `JPY`,  newline]

      
        , [`Sub`, `total`]


      ])
  
  , trace( [ `Found End line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
      
     generic_item( [ line_order_line_number, d, tab ] ) 

     , generic_item( [ line_item, s1, tab ] ) 
       
    , generic_item( [line_descr , s1 ,tab ] )

    , generic_item( [ line_quantity_uom_code, w, tab ] )

    , generic_item( [ line_quantity, d, tab ] )

    , generic_item( [ line_tax_code, w, tab ] )

    , generic_item( [ line_unit_amount, d, tab ] )

    , generic_item( [ line_net_amount, d, newline ] )

    %  , q10([	% LINE VAT Rate Calculation
  
   %   with( invoice , total_vat , VAT )

   %, with( invoice , total_net , Net )

   %, trace( [ `vat tot`, VAT ] )

  % , trace( [ `sub total`, Net ] )

   %, check(sys_calculate_str_divide( VAT, Net, VAT_RATE))

  % , trace( [ `VAT Rate`, VAT_RATE ] )
  
  % , check(sys_calculate_str_multiply( VAT_RATE, `100`, VAT_PERCENT )) 

 %  , generic_item( [ line_vat_rate , VAT_PERCENT ] )

     %  ])
          , q10( [ 

         with( invoice, delivery_note_number, Dnote ) % This takes the first value of delivery note no(captured in rule 'get_delivery_note_nr')

        , generic_item( [ line_delivery_note_number, Dnote ] ) % This stores the value in line_delivery_note for the current line
    
   ])  



] ).

%=======================================================================
i_line_rule_cut( line_invoice_line_1, [
%=======================================================================
      
     generic_item( [ line_item_dummy ,s1, tab ] ) 
       
    , `DO`, `-`

    , generic_item( [ line_delivery_note, d, `/` ] )

    , generic_item( [ line_buyers_order_number, d, `/` ] )

    , generic_item( [ line_so_no, d, newline ] )

      , q10( [ 

         with( invoice, delivery_note_number, Dnote ) % This takes the first value of delivery note no(captured in rule 'get_delivery_note_nr')

        , generic_item( [ line_delivery_note_number, Dnote ] ) % This stores the value in line_delivery_note for the current line
    
   ])  

] ).


%=======================================================================
i_line_rule_cut( line_dummy_line, [
%=======================================================================

    generic_item( [ line_dummy, s1, newline ] )


] ).

%=======================================================================
i_line_rule_cut( line_append_line, [
%=======================================================================

    generic_append( [ line_descr, s1, tab, ` , `, ` ` ] )

] ).


%=======================================================================
i_line_rule_cut( line_append_line_2, [
%=======================================================================

    generic_append( [ line_descr, s1, newline, ` , `, ` ` ] )
 
] ).

%=======================================================================
i_line_rule_cut( line_item_line, [
%=======================================================================

    
   [ `Customer`, `Material`, `Number`, `:`]
    
   , generic_item( [ line_item, s1, newline ] )
 
] ).


