i_date_format(`m/d/y`):- not( grammar_set( alternate_date_format ) ).

i_date_format(_):- grammar_set( alternate_date_format).

i_trace_lists.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    
      get_supplier_detail
      
    , get_supplier_address

    , get_buyer_address 
                      
    , get_invoice_number
    
    , get_invoice_date

    , get_order_number

    , get_delivery_note_number

    , get_total_net

    , get_currency

    , get_invoice_lines % No line details required as per Delivery team hence mapped the total amount as line amount

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

     sender_name( `SECURITAS SECURITY SERVICES USA INC` )

   , supplier_party( `SECURITAS SECURITY SERVICES USA INC` )

   , bill_from(`SECURITAS SECURITY SERVICES USA INC`)

   , supplier_vat_number(``) % Not available on Invoice

   , swiss_supplier_country(`US`)

   , currency(`USD`) % Currency hardcoded since no currency in Words provided on Invoice

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

     q(0,5,line)

   , line_add_line

   , q(0,1,line)

   , line_add_line_2

   , q(0,1,line)

   , line_add_line_3

   , q(0,1,line)

   , line_add_line_4

] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================
    
      read_ahead([`SECURITAS`])

    , trace( [ `Found address`] )

    , generic_item( [ swiss_supplier_name, s1,  newline ] )  

   
] ).

%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================

      generic_item( [ swiss_supplier_address_1, s1, tab ] )  

       
] ).

%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

      generic_item( [ swiss_supplier_address_2, s1, newline ] )  

       
] ).

%=======================================================================
i_line_rule( line_add_line_4, [
%=======================================================================

      generic_item( [ swiss_supplier_address_3, s1, tab ] )  

       
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% BUYER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_address, [
%=======================================================================

     q(0,25,line)

   , line_b_add_line_1

   , q(1,2,line)

   , line_b_add_line_2

   , q(0,1,line)

   , line_b_add_line_3

       
] ).


%=======================================================================
i_line_rule( line_b_add_line_1, [
%=======================================================================
    
      read_ahead([`Micron`])

    , trace( [ `Found address`] )
    
    , generic_item( [ swiss_buyer_name, s1, tab ] )   
       
] ).

%=======================================================================
i_line_rule( line_b_add_line_2, [
%=======================================================================
     
      generic_item( [ swiss_buyer_address_dummy, s1, tab ] )    

    , generic_item( [ swiss_buyer_address_1, s1, tab ] )    
    
] ).
%=======================================================================
i_line_rule( line_b_add_line_3, [
%=======================================================================
     
     generic_item( [ swiss_buyer_address_dummy1, s1, tab ] )    
     
    , generic_item( [ swiss_buyer_address_2, s1, tab ] )    
      
    ,  check( swiss_buyer_name = BillTo)

    , generic_item( [ bill_to , BillTo ] )  
    
] ).


