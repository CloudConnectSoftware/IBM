%=======================================================================
i_rule_cut( get_exchange_rate, [
%=======================================================================
last_line

,q(100,150,up)

    ,generic_horizontal_details( [ [`SGD`, `EXCHANGE`, `RATE`, `@` ], exchange_rate, d, newline] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INV AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule_cut(get_net_amount, [
%=======================================================================
      last_line

  ,q(0,500,up)  

   , generic_horizontal_details( [ [`Total`,`of` , `GOODS` ],750,  total_net, d,  newline ] )

] ).


%=======================================================================
i_rule_cut(get_total_invoice, [
%=======================================================================
      last_line

  ,q(0,100,up)  
   
   , generic_horizontal_details( [ [`USD` ],500,  total_invoice, d,  newline ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOTAL INV AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule(get_total_vat, [
%=======================================================================
    last_line

  ,q(0,500,up)  

  , generic_horizontal_details( [ [`GST`, `@`, generic_item( [ default_vat_rate,d ] ) , `%`],600,  total_vat, d,  newline ] )

    
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

    , or([

             line_invoice_line, line_descr_line

             , line

        ])

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================


      [`Shipped`, tab, `Back`, `Ordered`, tab, `Line` ]

      , trace( [ `Found Start line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
 
    or([
            [`TOTAL`, `OF`]

            , [`IMPORTANT`, `:`]
          , [`GST`, `@`]
      ])
  
  , trace( [ `Found End line` ] )

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================


     generic_item( [ line_quantity, d, tab ] )

    , q10(generic_item( [ line_quantity_ordered, w, tab ]  ))

    ,  generic_item( [ line_reference, w, tab ]  )

    ,  generic_item( [ line_class, w, tab ]  )

    ,  generic_item( [ line_mfr, w ]  )

    ,  generic_item( [ line_descr, s1, tab ]  )

    , generic_item( [ line_unit_amount_dummy, d, q10(tab) ] )

    ,  generic_item( [ line_quantity_uom_code, w, tab ] )

    , generic_item( [ line_net_amount, d, newline ] )

    , q10([ 

    with( invoice, delivery_note_number, Dnote ) % This takes the first value of delivery note no(captured in rule 'get_delivery_note_nr')
    , generic_item( [ line_delivery_note_number, Dnote ] ) % This stores the value in line_delivery_note for the current line
    
    ])

    , q10( [ 

    with( invoice, order_number, ONo ) % This takes the first value of Order Number no(captured in rule 'get_order_no')
    , generic_item( [ line_buyers_order_number, ONo ] ) % This stores the value in line_buyer_order_number for the current line
       
    ])

    , line_packing_list(`packing_xxxx`)

    , line_proforma(`proforma_xxxx`)


] ).

%=======================================================================
i_line_rule( line_descr_line, [
%=======================================================================

       generic_append( [ line_descr, s1, newline, ` - `, ` `  ] )
  
] ).



