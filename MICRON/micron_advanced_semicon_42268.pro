i_rule(get_total_net, [
%=======================================================================
   
    last_line

   , q(0,50,up)

   , or([ check_text(`SUB`)  ])

    , or([

     generic_horizontal_details( [ [`SUB`, `TOTAL`, `:`,  tab ],  total_net, d,  newline ] )

    , generic_horizontal_details( [ [`SUB`, `TOTAL`, `:`, tab, `SHIP`, `QTY`, `:`, tab, dummy(d), tab ],  total_net, d,  newline ] ) 

    ])
    
] ).


