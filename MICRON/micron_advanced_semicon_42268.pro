%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

     q(0,5,line)

   , line_add_line

   , q(0,2,line)

   , line_add_line_2

   , q(0,2,line)

   , line_add_line_3


] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================
    q0n(anything)

    ,  read_ahead([`#` , `550`])

    , trace( [ `Found address`] )

    , generic_item( [ swiss_supplier_address_1, s1, or([ tab, newline] ) ] )  

   
