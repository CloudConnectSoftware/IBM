%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

     q(0,15,line)

    , check_text(`invoice`) 

    ,  generic_horizontal_details( [ [`INVOICE`, q10(`No`), `:`  ],100, invoice_number, s1, newline ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

      q(0,20,line)

    , check_text(`Date`) 

    ,  or([
        
        generic_horizontal_details( [ [ `Date`,  `:`, q10(tab) ], invoice_date_raw, w, newline ] )

    ])

    , check( invoice_date_raw = DateRaw )    , trace( [ `Date raw` , DateRaw ] )

    , check(q_sys_sub_string( DateRaw, 1,4 , Substring1 ))    , trace( [ `Date raw1` , Substring1 ] )

    , check(q_sys_sub_string( DateRaw, 5,2 , Substring2 ))    , trace( [ `Date raw2` , Substring2 ] )

    , check(q_sys_sub_string( DateRaw, 7, 2 , Substring3 ))   , trace( [ `Date raw3` , Substring3 ] )

    , check(strcat_list( [ Substring3,` ` , Substring2,` `, Substring1 ], DateNew ))   , trace( [ `New Date Format` , DateNew ] ) 
    
	, invoice_date(DateNew)  , trace( [ `Invoice Date Now` , invoice_date ] )

] ).



