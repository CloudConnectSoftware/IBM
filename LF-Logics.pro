%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

q(0,15,line)

, generic_horizontal_details( [ [ `NNoo`, `.`, `.`, `:`, `:` ] , 100 , invoice_number , s1 , newline ] )

] ).

