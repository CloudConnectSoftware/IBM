i_version( pepc_pyramid_design , `22 May 2018` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( _ ).

i_date_language( english ).

i_trace_lists.

i_pdf_parameter( same_line, 7 ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	
	  get_supplier_detail

    , get_supplier_address
	          		
	%, get_supplier_bank_details
		
	, get_invoice_number
	
	, get_invoice_date

    , get_currency

    , get_invoice_due_date
	
	, get_order_number

    , get_total_invoices

    , get_vat_rate

    ,get_total_vat

    , get_invoice_lines

   , get_supplier_vat_code

    , get_remit_supplier

    , get_payment_terms

    , get_buyer_party

    , get_total_net

    , get_freight_line
	
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`Pyramid Design and Construction Co`)

    ,supplier_party(`Pyramid Design and Construction Co`)

	,supplier_vat_number(``)

    ,buyer_dept(``)

    ,buyer_registration_number(``)

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)


   , or([

   [generic_horizontal_details( [ [ ],  currency, w, [ `)`,  newline] ] )]


    
  ,currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)

    ,  `$`

    , generic_item( [ currency, `USD` ] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,100,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4

   
   ,q(0,1,line)

   ,line_suppadd_line_5


    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================

    read_ahead( [`Pyramid`] )

    ,trace( [ `Found SUPPLIER NAME`] )

    ,generic_item( [ supplier_party, s1, tab ] )


] ).


%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================
    

    generic_item( [ supplier_address_line, s1, newline ] )

     
] ).
 
%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================
    

    generic_item( [ supplier_address_line_dummy, s1, tab ] )

     
] ).

%=======================================================================
i_line_rule( line_suppadd_line_3, [
%=======================================================================
    

    generic_item( [ supplier_city, s,[q10(tab), check(supplier_city(end) < -240)] ] )

     , generic_item( [ dummy_line2, s,[q10(tab), check(dummy_line2(end) < -215)] ] )

     , generic_item( [ supplier_state, s,[q10(tab), check(supplier_state(end) < -162)] ] ) 

     , generic_item( [ supplier_postcode, s1,newline ] )

] ).
 

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET REMIT TO Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================
    
 q(0,100,line)
    
   , line_remitadd_line

   , q(0,1,line)

   ,line_add_line_remit_1

   
   , q(0,1,line)

   ,line_add_line_remit_2

   
   , q(0,1,line)

   ,line_add_line_remit_3

   
   , q(0,1,line)

   ,line_add_line_remit_4
   
   , q(0,1,line)

   ,line_add_line_remit_5
    
    
    
    
    
] ).

%=======================================================================
i_line_rule( line_remitadd_line, [
%=======================================================================

   
    read_ahead( [`Pyramid`] )


    ,trace( [ `Found Remit to address line `] )

    ,generic_item( [ remit_to_party, s1, tab ] )

    

] ).


%=======================================================================
i_line_rule( line_add_line_remit_1, [
%=======================================================================
   
 generic_item( [ remit_to_address_line, s1, newline ] )


] ).


%=======================================================================
i_line_rule( line_add_line_remit_2, [
%=======================================================================
   
 generic_item( [ dummy_remit_line_2, s1, tab ] )


] ).
%=======================================================================
i_line_rule( line_add_line_remit_3, [
%=======================================================================
  
  
  generic_item( [ remit_to_city, s, [q10(tab), check(remit_to_city(end) < 240)] ] )

, generic_item( [ remit_dummy_line2, s,[q10(tab), check(remit_dummy_line2(end) < -215)] ] )

, generic_item( [ remit_to_state, s, [q10(tab), check(remit_to_state(end) < 162)] ] )

, generic_item( [ remit_to_postcode, s1,newline ] )


] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,100,line)

   , line_add_line

   , q(0,1,line)

   ,line_add_line_1

   ,q(0,1,line)

   ,line_add_line_2

   ,q(0,1,line)

   ,line_add_line_3

   
   ,q(0,1,line)

   ,line_add_line_4

   
   ,q(0,1,line)

   ,line_add_line_5

   ,q(0,1,line)

   ,line_add_line_6     


    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    read_ahead([`Pepsico` ] )

    ,trace( [ `Found BUYER ADDRESS`] )

   ,generic_item( [ buyer_party, s1, newline ] )


] ).
%=======================================================================
i_line_rule( line_add_line_1, [
%=======================================================================


     generic_item( [dummy_address_line, s1,newline] )


] ).


%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================


     generic_item( [buyer_address_line, s1,newline] )


] ).



%=======================================================================
i_line_rule( line_add_line_6, [
%=======================================================================


     generic_item( [buyer_city, s,[q10(tab), check(buyer_city(end) < -365)] ] )

    ,  generic_item( [dummy_city_line_1, s, [q10(tab), check(dummy_city_line_1(end) < -342)] ] )

    , generic_item( [buyer_state, w ] ) 

     , generic_item( [buyer_postcode, s1,newline  ] ) 


] ).



