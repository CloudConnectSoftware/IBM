%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Invoice net
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_net, [
%======================================================================
    
          
    q0n(line)

    , set(reverse_punctuation_in_numbers) ,set(regexp_cross_word_boundaries)

    , generic_horizontal_details( [ [ `Mal`, `/`, `Hizmet`, `Toplam`, `Tutarı`, tab ], total_net, d, [`TL`,  newline] ] )

    , q(1,2,line)

    , generic_horizontal_details( [ [   `Hesaplanan`, `KDV`, `(`, `%`, generic_item( [ default_vat_rate, d ] ), `)`, tab], total_vat, d, [`TL`,  newline]] )

    , q(1,2,line)

    , generic_horizontal_details( [ [   `Ödenecek`, `Tutar`, tab], total_invoice, d, [`TL`,  newline] ] )

    , clear(reverse_punctuation_in_numbers) ,clear(regexp_cross_word_boundaries)
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [


            line_invoice_line

     
        , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [`Sır`, `a`, tab, `M`, `alzeme`, `/`, `H`, `izmet`, tab, `M`, `iktar`, tab, `Bir`, `im`, `Fiyat`, tab]
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
     [`Mal`, `/`, `Hizmet`, `Toplam`, `Tutarı`, tab ]

    ])
     , trace([`found the END line`])

] ).

%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
    

     generic_item( [ line_reference, d ] )  

    , generic_item( [ line_descr, s1, tab ] )

    , set(reverse_punctuation_in_numbers) ,set(regexp_cross_word_boundaries)

    , generic_item( [ line_quantity, d ] )

    , generic_item( [ line_quantity_uom_code, s1, tab ] )

    , generic_item( [ line_unit_amount_dummy, d, [`TL`, tab, `%`] ] )

    , generic_item( [ line_vat_rate, d, [q10(tab), check(line_vat_rate(end) < 193)] ] )

    , generic_item( [ line_vat_amount_dummy, d, [`TL`, tab] ] )

    , generic_item( [ line_net_amount, d, [`TL`, newline] ] ) 

    , clear(reverse_punctuation_in_numbers) ,clear(regexp_cross_word_boundaries)

] ).


