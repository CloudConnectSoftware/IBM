% INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================
  
   q(0,20,line)

   , or([

      generic_horizontal_details( [ [`INVOICE`, q10(tab) ], invoice_number, s1, newline ] )

  ])

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

q(0,20,line)


  ,generic_horizontal_details( [ [ `Date`  ], invoice_date_raw, s1, tab ] )
  
    , check( invoice_date_raw = DateRaw )    , trace( [ `Date raw` , DateRaw ] )

    , check(q_sys_sub_string( DateRaw, 1,3 , Substring1 ))    , trace( [ `Date raw1` , Substring1 ] )

    , check(q_sys_sub_string( DateRaw, 4,2 , Substring2 ))    , trace( [ `Date raw2` , Substring2 ] )

    , check(q_sys_sub_string( DateRaw, 7, 2 , Substring3 ))   , trace( [ `Date raw3` , Substring3 ] )

    , check(strcat_list( [ Substring2,` ` , Substring1,` `, Substring3 ], DateNew ))   , trace( [ `New Date Format` , DateNew ] ) 
    
	, invoice_date(DateNew)  , trace( [ `Invoice Date Now` , invoice_date ] )

   
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% get Due Date
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_due_date, [
%=======================================================================
    q(0,135,line)

    ,or([
        
        generic_horizontal_details( [ [`Due`, `date` ],  due_date_raw, s1, newline] )

        , check( due_date_raw = DDateRaw )    , trace( [ `Date raw` , DDateRaw ] )

    , check(q_sys_sub_string( DDateRaw, 1,4 , DSubstring1 ))    , trace( [ `Date raw1` , DSubstring1 ] )

    , check(q_sys_sub_string( DDateRaw, 4,2 , DSubstring2 ))    , trace( [ `Date raw2` , DSubstring2 ] )

    , check(q_sys_sub_string( DDateRaw, 7, 2 , DSubstring3 ))   , trace( [ `Date raw3` , DSubstring3 ] )

    , check(strcat_list( [ DSubstring1,` ` , DSubstring2,` `, DSubstring3 ], DDateNew ))   , trace( [ `New Date Format` , DDateNew ] ) 
    
	, due_date(DDateNew)  , trace( [ `due Date Now` , due_date ] )

    ])

] ).

