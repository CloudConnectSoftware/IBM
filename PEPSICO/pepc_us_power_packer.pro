% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,150,line)

   , line_add_line

   , q(1,2,line)

   , line_add_line_1

   , q(0,1,line)

   , line_add_line_2

   , q(0,1,line)

   , line_add_line_3
   
   , q(0,1,line)

   , line_add_line_4

   , q(0,1,line)

   , line_add_line_5

   , q(0,1,line)
 
   , line_add_line_6     


    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    q0n(anything)

    , read_ahead([ `Frito` ] )

    , trace( [ `Found BUYER ADDDRESS line`] )

    ,generic_item( [ buyer_party, s ,[`*`, tab] ] )

  
] ).


%=======================================================================
i_line_rule( line_add_line_1,  [
%=======================================================================

     generic_item( [buyer_address_line, s1, tab ] )

] ).


%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================

     generic_item( [ buyer_city, w, `,` ] )

    , generic_item( [ buyer_state, w ] )

    , generic_item( [buyer_postcode, s, tab  ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================
    
	q(0,130,line)
	
    , generic_horizontal_details( [ [ `Invoice`, `Number`, `:`, tab ], invoice_number_raw, s, newline ] )

    
    , check( invoice_number_raw = INVRaw )

    , trace( [ `INV_raw` , INVRaw ] )

    , check(string_string_replace( INVRaw, `-`, ``, INVstrip ))

    , trace( [ `INV Stripped ` , INVstrip ] )

    , invoice_number(INVstrip) 

    
] ).


