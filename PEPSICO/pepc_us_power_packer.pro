%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET Invoice Total 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_invoices, [
%=======================================================================
    
    last_line

    , q(0,300,up)

    ,  generic_horizontal_details( [ [`Invoice`, `Total`, `Amount`, `:`, tab, `$` ], total_invoice, d, newline ] )
    
    , check( total_invoice = TotInv )

    , trace( [ `Total Inv v` , TotInv] )

    , total_net(TotInv)

    , trace( [ `Total net` , total_net] )

            
] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [

                                        
        line_invoice_line
        
     
        , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [`PO`, `/`, `Billing`, `Code`, `:`]
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
    
     [`PLEASE`, `REMIT`, `PAYMENT`, `TO`, `:`, tab, `Invoice`, `Total`, `Amount`, `:`, tab]

    ])
     , trace([`found the END line`])

] ).

%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================

     generic_item( [ line_descr, s1, [tab, `$`] ] )

    , generic_item( [ line_net_amount, d,  newline ] )
    

] ).

%=======================================================================
i_line_rule_cut( line_invoice_line_1, [
%=======================================================================

     generic_item( [ line_descr, s1, [tab, `$`] ] )

    , generic_item( [ line_unit_amount, d, [`/`, `LOT`, tab, `$`] ] )

    , generic_item( [ line_net_amount, d,  [ dummy(w),  newline] ] )
    

] ).




