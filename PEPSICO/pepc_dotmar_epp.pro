%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_address, [
%=======================================================================
  
      q(0,20,line)

    , line_add_line1

    , q(1,2,line)

    , line_add_line2

    , q(1,2,line)

    , line_add_line3

    , q(1,2,line)

    , line_add_line4
] ).

%=======================================================================
i_line_rule( line_add_line1, [
%=======================================================================
    
    
    or([
        
      read_ahead(`PepsiCo`)

] )
   , trace( [ `Found address`] )

   , generic_item( [buyer_party , s1, tab ] )

   , generic_item( [buyer_party_dummy , s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line2, [
%=======================================================================
  
      generic_item( [ buyer_address_line,s1, tab ] )

    , generic_item( [ buyer_addressdummy,s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line3, [
%=======================================================================
  
  
        generic_item( [ buyer_city, w , `,` ] )

      , generic_item( [ buyer_state, w ] )

      , generic_item( [ buyer_postcode, s1, newline ] )

] ).

