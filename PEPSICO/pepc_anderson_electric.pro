i_version( pepc_anderson_electric , `26 May 2018` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( _ ).

i_date_language( dutch ).

i_trace_lists.

i_pdf_parameter( same_line, 7 ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	
	  get_supplier_detail

    , get_supplier_address
	          		
	, get_supplier_bank_details
		
	, get_invoice_number
	
	, get_invoice_date

    , get_currency

    , get_invoice_due_date
	
	, get_order_number

    , get_total_invoices

    , get_vat_rate

    ,get_total_vat

    , get_invoice_lines

   , get_supplier_vat_code

    , get_remit_supplier

    , get_payment_terms

    , get_buyer_party

    , get_total_net

    , get_freight_line

    , get_buyer_vat_number

    , get_delivery_note
	
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`ANDERSON ELECTRIC`)

    ,supplier_party(`ANDERSON ELECTRIC`)

    ,remit_to_party(`ANDERSON ELECTRIC`)

	,supplier_vat_number(`N/A`)


] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET Remit to Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================

    q(0,100,line)

   , line_remitsupp_line

   , q(0,1,line)

   ,line_remitsupp_line_1

   ,q(0,1,line)

   ,line_remitsupp_line_2

   ,q(0,1,line)

   ,line_remitsupp_line_3

   ,q(0,1,line)

   ,line_remitsupp_line_4

   
   ,q(0,1,line)

   ,line_remitsupp_line_5


    
] ).

%=======================================================================
i_line_rule( line_remitsupp_line, [
%=======================================================================
   

    read_ahead( [ `3501`, `S`, `6th`, `St`] )

    ,trace( [ `Found address Line`] )

    ,generic_item( [ remit_to_address_line, s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_remitsupp_line_1, [
%=======================================================================

   generic_item( [ remit_to_city, s,[q10(tab), check(remit_to_city(end) < -341)] ] )

  , generic_item( [ dummy_line1, s,[q10(tab), check(dummy_line1(end) < -330)] ] ) 

  , generic_item( [ remit_to_state, s,[q10(tab), check(remit_to_state(end) < -291)] ] )

  , generic_item( [ remit_to_postcode, s1, newline ] )

   
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,100,line)

   , line_add_line

   , q(0,1,line)

   ,line_add_line_1

   ,q(0,1,line)

   ,line_add_line_2

   ,q(0,1,line)

   ,line_add_line_3

   
   ,q(0,1,line)

   ,line_add_line_4

   
   ,q(0,1,line)

   ,line_add_line_5

   ,q(0,1,line)

   ,line_add_line_6     


    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    read_ahead([ `Quaker`, `Manufacturing`  ] )

    ,trace( [ `Found BUYER ADDDRESS line`] )

   ,generic_item( [ buyer_party, s1,tab ] )

  
] ).

%=======================================================================
i_line_rule( line_add_line_1, [
%=======================================================================

  generic_item( [ buyer_dummy_line, s1, tab ] )

] ).

%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================

 generic_item( [ buyer_address_line, s1, tab ] )
 


] ).


%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

     generic_item( [buyer_city, s, [q10(tab), check(buyer_city(end) < -357)] ] )

    ,generic_item( [buyer_dummy, s, [q10(tab), check(buyer_dummy(end) < -334)] ] )

    , generic_item( [buyer_state, s,[q10(tab), check(buyer_state(end) < -289)] ] )

    , generic_item( [buyer_postcode, s1, tab] )


 


] ).


