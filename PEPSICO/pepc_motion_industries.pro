%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`Motion Industries`)

    ,supplier_party(`Motion Industries `)

    
	,supplier_vat_number(``)

    ,buyer_dept(``)

    ,buyer_registration_number(``)

    ,remit_to_party(`Motion Industries `)

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,30,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4

   
   ,q(0,1,line)

   ,line_suppadd_line_5


    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   

    read_ahead( [`MOTION`, `INDUSTRIES`] )

    ,trace( [ `Found SUPPLIER Line`] )

   , generic_item( [ supplier_party,s1 , tab ] )
] ).


%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================

    generic_item( [supplier_address_line,s1, tab ] )

] ).

%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================

 generic_item( [ supplier_city, s,[q10(tab), check(supplier_city(end) < -371)] ] )

, generic_item( [ dummy_sup_line, s,[q10(tab), check(dummy_sup_line(end) < -355)] ] )

, generic_item( [ supplier_state, s,[q10(tab), check(supplier_state(end) < -308)] ] )

, generic_item( [ supplier_postcode, s1,tab ] )
   
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET REMIT To Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================

    q(0,30,line)

   , line_remitadd_line

   , q(0,1,line)

   ,line_remitadd_line_1

   ,q(0,1,line)

   ,line_remitadd_line_2

   ,q(0,1,line)

   ,line_remitadd_line_3

   ,q(0,1,line)

   ,line_remitadd_line_4

   
   ,q(0,1,line)

   ,line_remitadd_line_5


    
] ).

%=======================================================================
i_line_rule( line_remitadd_line, [
%=======================================================================
   

    read_ahead( [`REMIT`, `TO`, `:`, tab, `P`, `.`, `O`, `.`, `DRAWER`] )

    ,trace( [ `Found SUPPLIER Line`] )

    , generic_item( [ dummy_remit_1,s1 , tab ] )

   , generic_item( [ remit_to_address_line,s1 , tab ] )
] ).


%=======================================================================
i_line_rule( line_remitadd_line_1, [
%=======================================================================

 generic_item( [ dummy_remit_line, s1, tab ] )

, generic_item( [ supplier_city, s,[q10(tab), check(supplier_city(end) < 162)] ] )

, generic_item( [ dummy_remit_line_1, s,[q10(tab), check(dummy_remit_line_1(end) < 176)] ] )

, generic_item( [ supplier_state, s,[q10(tab), check(supplier_state(end) < 216)] ] )

, generic_item( [ supplier_postcode, s1,tab ] )
   
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)


   , or([

  % [generic_horizontal_details( [ [ `INVOICE`, `TOTAL`, `:`, tab, dummy_curr_code(w), tab, dummy_total(d) ], 100, currency, w, newline ] )]


    
    currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)

    ,  [`USD`]

    , generic_item( [ currency, `USD` ] )

] ).




