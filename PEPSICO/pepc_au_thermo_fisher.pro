%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   Despatch Amount
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_freight_line, [
%======================================================================
    
    last_line

    , q(0,40,up)

    , generic_horizontal_details( [ [`Despatch`, `:`, `$` ], line_net_amount, d, newline ] )

    , generic_item( [ line_descr, `Despatch:`] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [


         [line_invoice_line,line_invoice_line_append, line_invoice_line_append_1]

        , line_invoice_line__1

     
        , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [`Item`, tab, `Description`, tab, `Qty`, `Ordered`, tab] 
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
     [`Note`, `invoice`, `in` ]

    ])
     , trace([`found the END line`])

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
    

     generic_item( [ line_item, s, [q10(tab), check(line_item(end) < -310)] ] )

    , generic_item( [ line_descr, s1, tab ] ) 

    , generic_item( [ line_quantity_dummy, d, q10(tab) ] )

    , generic_item( [ line_quantity, d, tab] )

    , generic_item( [ line_dummy_qty, d, [ tab, `$`]  ] )

    , generic_item( [ line_unit_amount, d,[ tab, `$`]] )

    , generic_item( [ line_net_amount, d, newline ] )


] ).


%=======================================================================
i_line_rule_cut( line_invoice_line_append, [
%=======================================================================
    

     generic_append( [ line_item, s1, tab, ``, `` ] )

    , generic_append( [ line_descr, s1,newline, ` `, `` ] ) 


] ).

%======================================================================
i_line_rule_cut( line_invoice_line_append_1, [
%=======================================================================
    

     generic_append( [ line_descr, s1,newline, ` `, `` ] ) 


] ).


%======================================================================
i_line_rule_cut( line_invoice_line__1, [
%=======================================================================
    
      generic_item( [ line_item, s1, tab ] )

    , generic_item( [ line_descr, s1, [tab, `$`] ] ) 

    , generic_item( [ line_unit_amount, d, [ tab, `$`] ] )

    , generic_item( [ line_net_amount, d, newline ] )


] ).

