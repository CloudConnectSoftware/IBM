i_version( pepc_bt_america_inc , `22 May 2018` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( _ ).

i_date_language( dutch ).

i_trace_lists.

i_pdf_parameter( same_line, 7 ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	
	  get_supplier_detail

    , get_supplier_address
	          		
	, get_supplier_bank_details
		
	, get_invoice_number
	
	, get_invoice_date

    , get_currency

    , get_invoice_due_date
	
	, get_order_number

    , get_total_invoices

    , get_vat_rate

    ,get_total_vat

    , get_invoice_lines

   , get_supplier_vat_code

    , get_remit_supplier

    , get_payment_terms

    , get_buyer_party

    , get_total_net
	
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`BT America Inc`)

    ,supplier_party(`BT America Inc`)

	,supplier_vat_number(`13-3459785`)

    ,buyer_dept(``)

    ,buyer_registration_number(``)

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)


   , or([

   [generic_horizontal_details( [ [`Amount`, `(` ],  currency, w, [ `)`,  newline] ] )]


    
  ,currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)

    ,  `$`

    , generic_item( [ currency, `USD` ] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,100,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4


    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================

    read_ahead(` BT`)

    ,trace( [ `Found SUPPLIER `] )

    ,generic_item( [ supplier_party, s,[q10(tab), check(supplier_party(end) < -91)] ] )

     ,generic_item( [ dummy_addline, s, [q10(tab), check(dummy_addline(end) < -61)] ] )

    ,generic_item( [ supplier_address_line, s, [q10(tab), check(supplier_address_line(end) < 54)] ] )

     ,generic_item( [ supplier_address_line1, s, [q10(tab), check(supplier_address_line1(end) < 149)] ] )



     ,generic_item( [ supplier_city, s, [q10(tab), check(supplier_city(end) < 153)] ] )
     
     ,generic_item( [ dummy_addline1, s, [q10(tab), check(dummy_addline1(end) < 171)] ] )

      ,generic_item( [ supplier_state, s, [q10(tab), check(supplier_state(end) < 174)] ] )

      ,generic_item( [ dummy_addline3, s, [q10(tab), check(dummy_addline3(end) < 210)] ] )

      ,generic_item( [ supplier_postcode, s1, newline] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET REMIT TO Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================
    last_line

 , q(0,30,up)
    
   , line_remitadd_line

   , q(0,1,line)

   ,line_add_line_remit_1
    
] ).

%=======================================================================
i_line_rule( line_remitadd_line, [
%=======================================================================

    read_ahead(`Payment`)

    ,trace( [ `Found Remit to address line `] )


,generic_item( [ dummy_remit_line, s, [q10(tab), check(dummy_remit_line(end) < -356)] ] )

,generic_item( [ remit_to_party, s1, tab ] )

] ).


%=======================================================================
i_line_rule( line_add_line_remit_1, [
%=======================================================================
   
 generic_item( [ remit_to_address_line, s, [q10(tab), check(remit_to_address_line(end) < -312)] ] )

 , generic_item( [ remit_to_city, s, [q10(tab), check(remit_to_city(end) < -262)] ] )

, generic_item( [ dummy_line, s, [q10(tab), check(dummy_line(end) < -247)] ] )

, generic_item( [ remit_to_state, s, [q10(tab), check(remit_to_state(end) < -206)] ] )



, generic_item( [ remit_to_postcode, s1,tab ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER BANK ACCOUNT NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_bank_details, [
%=======================================================================

    last_line
	
    ,q(0,20,up)

    , generic_horizontal_details( [ [`Bank`, tab, `Bank`, `Account`, `No`, `:`],  remit_to_bank_account_number, s1,tab ] ) 

    ,generic_horizontal_details( [ [ `International`, `Swift`, `Code`, `:`],  remit_to_bank_code, s1, tab ] ) 

] ).




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,100,line)

   , line_add_line

   , q(0,1,line)

   ,line_add_line_1

   ,q(0,1,line)

   ,line_add_line_2

   ,q(0,1,line)

   ,line_add_line_3

   
   ,q(0,1,line)

   ,line_add_line_4



    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    read_ahead(`PepsiCo`)

    ,trace( [ `Found BUYER ADDRESS`] )

    ,generic_item( [ buyer_party, s1, tab ] )


] ).
%=======================================================================
i_line_rule( line_add_line_1, [
%=======================================================================


     generic_item( [dummy_address_line, s1,tab] )


] ).

%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================


     generic_item( [dummy_address_line_1, s1,tab] )


] ).

%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================


     generic_item( [buyer_address_line, s1,tab] )


] ).

%=======================================================================
i_line_rule( line_add_line_4, [
%=======================================================================


     generic_item( [buyer_city, s,[q10(tab), check(buyer_city(end) < -370)] ] )

    , generic_item( [buyer_state, s,[q10(tab), check(buyer_state(end) < -315)] ] ) 

     , generic_item( [buyer_postcode, s1,tab  ] ) 


] ).




