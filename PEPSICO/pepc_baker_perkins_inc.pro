% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`BAKER PERKINS INC`)

    ,supplier_party(`BAKER PERKINS INC`)

    
	,supplier_vat_number(``)

    ,buyer_dept(``)

    ,buyer_registration_number(``)

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)


   , or([

   [generic_horizontal_details( [ [ `Currency`, tab ],  currency, s1,newline] )]

      
  %,currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)
    
    ,or([
    
      [`$`]

     ,[`USD`] 

    

    , generic_item( [ currency, `USD` ] )

    ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,30,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4

   
   ,q(0,1,line)

   ,line_suppadd_line_5


    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   

    read_ahead( [ `Baker`, `Perkins`] )

    ,trace( [ `Found SUPPLIER Line`] )

   , generic_item( [ supplier_party,s1 , newline ] )
] ).

%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================

    generic_item( [ supplier_address_line,s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================

   generic_item( [ supplier_city, s,[q10(tab), check(supplier_city(end) < 320)] ] )

  , generic_item( [ supplier_state, s,[q10(tab), check(supplier_state(end) < 360)] ] )

  , generic_item( [ supplier_postcode, s1, newline ] )

   
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET Remit to Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================
last_line

  ,  q(0,60,up)

   , line_remitsupp_line

   , q(0,1,line)

   ,line_remitsupp_line_1

   ,q(0,1,line)

   ,line_remitsupp_line_2

   ,q(0,1,line)

   ,line_remitsupp_line_3

   ,q(0,1,line)

   ,line_remitsupp_line_4

   
   ,q(0,1,line)

   ,line_remitsupp_line_5


    
] ).

%=======================================================================
i_line_rule( line_remitsupp_line, [
%=======================================================================
   

    read_ahead( [ `Payment`, `Due`, `Date` ] )

    ,trace( [ `Found address Line`] )


    , generic_item( [ dummy_remit_line, s1, tab ] )

    ,generic_item( [ remit_to_party, s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_remitsupp_line_1, [
%=======================================================================

generic_item( [ remit_to_address_line, s1, newline ] )

   
] ).


%=======================================================================
i_line_rule( line_remitsupp_line_2, [
%=======================================================================


   generic_item( [ dummy_remit_line_1, s1 , tab ] )

  , generic_item( [ dummy_remit_line_1, s1 , tab ] ) 

  , generic_item( [ remit_to_city, s,[q10(tab), check(remit_to_city(end) < 226)] ] )

  , generic_item( [ remit_to_state, s,[q10(tab), check(remit_to_state(end) < 266)] ] )

  , generic_item( [ remit_to_postcode, s1, newline ] )

   
] ).

