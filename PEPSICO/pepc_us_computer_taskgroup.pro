] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)


   , or([

   [generic_horizontal_details( [ [ `Currency`, tab ],  currency, s1,newline] )]

      
  ,currency_alternate


    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)
    
    ,or([
    
      [`$`]

      ,[`USD`]

    , generic_item( [ currency, `USD` ] )

    ])

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,30,line)

   , line_suppadd_line
    
   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4



    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   

    read_ahead( [ `L`, tab, `Frito`, `-`, `Lay`, `Inc`, tab, `M`, tab, `Computer` ] )

    ,trace( [ `Found SUPPLIER Line`] )

    , generic_item( [ line_supp_dummy,s1 , tab ] )

    , generic_item( [ line_supp_dummy_1,s1 , tab ] )

    , generic_item( [ line_supp_dummy_2,s1 , tab ] )

   , generic_item( [ supplier_party,s1 , newline ] )
   
] ).

%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================

     generic_item( [ line_supp_dummy_3,s1 , tab ] )

    , generic_item( [ line_supp_dummy_4,s1 , tab ] )

    , generic_item( [ line_supp_dummy_5,s1 , tab ] )

    ,generic_item( [ supplier_address_line,s1, newline ] )

] ).



%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================

     generic_item( [ line_supp_dummy_6,s1 , tab ] )

    , generic_item( [ line_supp_dummy_7,s1 , tab ] )

    , generic_item( [ line_supp_dummy_8,s1 , tab ] )
   
    , generic_item( [ supplier_city, w, `,`] )

    , generic_item( [ supplier_state, w, newline ] )

      
] ).


%=======================================================================
i_line_rule( line_suppadd_line_3, [
%=======================================================================

     generic_item( [ line_supp_dummy_6,s1 , tab ] )

    , generic_item( [ supplier_postcode, s1, newline ] )

      
] ).


