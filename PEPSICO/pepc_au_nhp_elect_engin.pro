%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Invoice net
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_net, [
%======================================================================
    
          
     q(0,100,line)

    , generic_vertical_details( [ [  `Total`, `Excluding`, `GST`, tab ], `Total`, q(0,1), (end, 10, 300), total_net, d, [ tab, generic_item( [ total_vat, d ] ), tab, generic_item( [ total_invoice, d ] ),  newline ] ] )


] ).




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [


          [line_invoice_line, line_invoice_line_append]

     
        , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [ `Product`, `Code`, tab, `Description`, tab, `Qty`, tab]
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
     [ `Total`, `Misc`, `.`, `Charge`, tab, `Due`, `Date`, tab, `Total`, `Excluding`, `GST`, tab]

    ])
     , trace([`found the END line`])

] ).



%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
    
      generic_item( [ line_item, s, tab ] ) 

    , q10( generic_item( [ line_dummy_line, w, tab ] ))  
    
    , generic_item( [ line_descr, s, q10(tab) ] )   

    , q10( generic_item( [ line_quantity_uom_code, w, tab ] )  )

    , generic_item( [ line_quantity_ordered, d, tab ] ) 

    , generic_item( [ line_quantity, d, tab ] ) 

    , generic_item( [ line_dummy_line_1, d, tab ] ) 

    , generic_item( [ line_unit_amount_dummy, d, tab ] )

    , generic_item( [ line_net_amount, d, newline ] )
    

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line_append, [
%=======================================================================
    
    generic_append( [ line_descr, s1, newline, ` `, `` ] )

] ).


