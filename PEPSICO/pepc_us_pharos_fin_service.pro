% GET Invoice Total
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_invoices, [
%=======================================================================
    
    last_line

    , q(0,20,up)

    , generic_horizontal_details( [ [ `Total`, `Due`, `:`, tab, `$`, tab ], total_invoice, d, tab ] )
  
    
] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [

                                        
        line_invoice_line
        

        , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [`Schedule`, tab, `Billing`, `Period`, tab, `Rental`, `Amount`, tab]
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
    
     [`Total`, tab]

    ])
     , trace([`found the END line`])

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
 

      generic_item( [ line_item, s, tab ] )

    , generic_item( [ line_descr, s1, [ tab, `$`, tab] ] )
    
    , generic_item( [ line_net_amount, d, [`$`, tab]] )

    , generic_item( [ line_vat_amount, d, [`$`, tab] ] )

    , generic_item( [ line_amount_dummy, d, [tab, `$`, tab] ] )

    , generic_item( [ line_total_amount, d, newline ] )


] ).



