%=======================================================================
i_rule( get_total_net, [
%=======================================================================
    
    last_line

    , q(0,20,up)

    , generic_horizontal_details( [ [ `Total`, tab, `$`, tab, generic_item( [ total_net, d ] ), `$`, tab ],total_vat, d, [`$`, tab] ] )
  
    
