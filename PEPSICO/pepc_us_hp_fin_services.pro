%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET Invoice Total  NET
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_net, [
%=======================================================================
    
    last_line

    , q(0,300,up)

    , generic_horizontal_details( [ [ `Sales`, `Tax`, tab, `$` ], total_vat_1, d, newline ] )
  
    , q(0,1,line)

    , generic_horizontal_details( [ [ `Total`, tab, `$`], total_invoice_1, d, newline ] )

    

      , check( total_vat_1= TotNet1 ) , trace( [ `Total VAT Raw 1` ,TotNet1 ] )  
    
      , check( total_invoice_1= TotNet2 ) , trace( [ `Total INV Raw 2` ,TotNet2 ] )

      , check(sys_calculate_str_subtract( TotNet2, TotNet1, TotNetNew))  ,total_net(TotNetNew) , trace( [ `Total net` , total_net ] )

  
    
] ).

