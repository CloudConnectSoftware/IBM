%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE TOTALS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_invoices, [
%=======================================================================
   
    q(0,100,line)

    , generic_horizontal_details( [ [ `Total`, `Amount`, `Due`, `:`, tab ],  total_invoice, d, newline ] )

     , check( total_invoice = TotInv )

        , trace( [ `Total Inv v` , TotInv] )

        , total_net(TotInv)

        , trace( [ `Total net` , total_net] )

    
] ).






%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [

             
             line_inovice_item
              
              , line_invoice_line 

                   
              , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
    
    [ `Pickup`, `Date`, tab, `Generator`, tab, `Manifest` ]
     
    ])

    
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
   
   [ `Pickup`, `Date`, tab, `Generator`, tab, `Manifest`]

   ,[`Pay`, `this`, `Amount`]
 
    
    ])
     , trace([`found the END line`])

] ).


%=======================================================================
i_line_rule_cut( line_inovice_item, [
%=======================================================================
 
 generic_item( [ line_reference,d, tab ] )

 , generic_item( [ line_dummy,d, newline ] )

] ).



%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
  

   generic_item( [line_descr , s1,tab ]  )

  , generic_item( [line_item , s1,tab ]  ) 

  , q10(generic_item( [line_quantity_dummy , d,tab ]  ) )

  , generic_item( [line_quantity_uom_code , s1,tab ]  )

  , generic_item( [line_quantity , d,tab ]  )

  , generic_item( [line_unit_amount , d, q10(tab) ]  )

  , generic_item( [line_net_amount , d, newline ]  )

] ).

