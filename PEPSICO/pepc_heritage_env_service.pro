i_version( pepc_heritage_env_service , `25 May 2018` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( `m/d/y` ).

i_trace_lists.

i_pdf_parameter( same_line, 7 ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	
	  get_supplier_detail

    , get_supplier_address
	          		
	, get_supplier_bank_details
		
	, get_invoice_number
	
	, get_invoice_date

    , get_currency

    , get_invoice_due_date
	
	, get_order_number

    , get_total_invoices

    , get_vat_rate

    , get_total_vat

    , get_invoice_lines

    , get_supplier_vat_code

    , get_remit_supplier

    , get_payment_terms

    , get_buyer_party

    , get_total_net

    , get_freight_line

    , get_buyer_vat_number
	
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER DETAIL
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`HERITAGE ENVIRONMENTAL SERVICES LLC`)

    ,supplier_party(`HERITAGE ENVIRONMENTAL SERVICES LLC`)

	,supplier_vat_number(`N/A`)

] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Get Currency
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

    q(0,50,line)

   , or([

   [generic_horizontal_details( [ [ `Invoice`, `Total`, tab ],  currency, w,tab] )]
   
  ,currency_alternate

    ])


] ).


%=======================================================================
i_line_rule( currency_alternate, [
%=======================================================================

    q0n(anything)
    
    ,or([
    
      [`$`]

     ,[`USD`] 

    

    , generic_item( [ currency, `USD` ] )

    ])

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,30,line)

   , line_suppadd_line

   , q(0,1,line)

   , line_suppadd_line_1

   , q(0,1,line)

   , line_suppadd_line_2

   , q(0,1,line)

   , line_suppadd_line_3

   , q(0,1,line)

   , line_suppadd_line_4
   
   , q(0,1,line)

   , line_suppadd_line_5


    
] ).

%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   

    read_ahead( [`HERITAGE`, `ENVIRONMENTAL`] )

    ,trace( [ `Found SUPPLIER Line`] )

   , generic_item( [ supplier_party,s1 , tab ] )
] ).

%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================

    generic_item( [ supplier_address_line,s1, tab ] )

] ).

%=======================================================================
i_line_rule( line_suppadd_line_2, [
%=======================================================================

   generic_item( [ supplier_city, s,[q10(tab), check(supplier_city(end) < -389)] ] )

  , generic_item( [ dummy_line1, s,[q10(tab), check(dummy_line1(end) < -367)] ] )

  , generic_item( [ supplier_state, s,[q10(tab), check(supplier_state(end) < -314)] ] )

  , generic_item( [ supplier_postcode, s1, tab ] )

   
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET Remit to Supplier
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_supplier, [
%=======================================================================

    q(0,100,line)

   , line_remitsupp_line

   , q(0,1,line)

   ,line_remitsupp_line_1

   ,q(0,1,line)

   ,line_remitsupp_line_2

   ,q(0,1,line)

   ,line_remitsupp_line_3

   ,q(0,1,line)

   ,line_remitsupp_line_4

   
   ,q(0,1,line)

   ,line_remitsupp_line_5


    
] ).

%=======================================================================
i_line_rule( line_remitsupp_line, [
%=======================================================================
   

    read_ahead( [`HERITAGE`, `ENVIRONMENTAL`] )

    ,trace( [ `Found SUPPLIER Line`] )

    ,generic_item( [ remit_to_party, s1, tab ] )

] ).

%=======================================================================
i_line_rule( line_remitsupp_line_1, [
%=======================================================================

 generic_item( [ remit_to_address_line, s1, tab ] )

] ).

%=======================================================================
i_line_rule( line_remitsupp_line_2, [
%=======================================================================

   generic_item( [ remit_to_city, s,[q10(tab), check(remit_to_city(end) < -389)] ] )

  , generic_item( [ dummy_line1, s,[q10(tab), check(dummy_line1(end) < -367)] ] )

  , generic_item( [ remit_to_state, s,[q10(tab), check(remit_to_state(end) < -314)] ] )

  , generic_item( [ remit_to_postcode, s1, tab ] )

   
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET BUYER PARTY DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_party, [
%=======================================================================

    q(0,100,line)

   , line_add_line

   , q(0,1,line)

   ,line_add_line_1

   ,q(0,1,line)

   ,line_add_line_2

   ,q(0,1,line)

   ,line_add_line_3

   
   ,q(0,1,line)

   ,line_add_line_4

   
   ,q(0,1,line)

   ,line_add_line_5

   ,q(0,1,line)

   ,line_add_line_6     


    
] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

    read_ahead([  `PEPSICO` ] )

    ,trace( [ `Found BUYER ADDRESS`] )

   
    ,generic_item( [ buyer_party, s1, newline ] )

  
] ).

%=======================================================================
i_line_rule( line_add_line_1, [
%=======================================================================

 generic_item( [ buyer_dummy_line, s1, newline ] )


] ).
%=======================================================================
i_line_rule( line_add_line_2, [
%=======================================================================

 generic_item( [ buyer_dummy_line1, s1, newline ] )


] ).

%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

  generic_item( [ buyer_address_line, s1, newline ] )


] ).


%=======================================================================
i_line_rule( line_add_line_4, [
%=======================================================================


   
     generic_item( [buyer_city, s, [q10(tab), check(buyer_city(end) < -342)] ] )

    , generic_item( [dummy_line_1, s, [q10(tab), check(dummy_line_1(end) < -328)] ] ) 

    , generic_item( [buyer_state, s,[q10(tab), check(buyer_state(end) < -283)] ] )

    , generic_item( [buyer_postcode, s1, newline] )


] ).



