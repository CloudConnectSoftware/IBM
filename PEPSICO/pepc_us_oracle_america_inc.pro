% GET SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    

    q(0,50,line)

   , line_suppadd_line

   , q(0,1,line)

   ,line_suppadd_line_1

   ,q(0,1,line)

   ,line_suppadd_line_2

   ,q(0,1,line)

   ,line_suppadd_line_3

   ,q(0,1,line)

   ,line_suppadd_line_4

   
   ,q(0,1,line)

   ,line_suppadd_line_5


    
] ).


%=======================================================================
i_line_rule( line_suppadd_line, [
%=======================================================================
   
     q0n(anything)

    
    ,or([

     read_ahead( [`500`, `Eldorado` ] )

    ] )

    ,trace( [ `Found SUPPLIER Line`] )

    , generic_item( [ supplier_party,`Oracle America, Inc.`  ] )

    , generic_item( [ supplier_address_line, s1, tab ] )




] ).




%=======================================================================
i_line_rule( line_suppadd_line_1, [
%=======================================================================
   
     generic_item( [ supplier_city, s, `,` ] )

    , generic_item( [ supplier_state, w ] ) 

    , generic_item( [ supplier_postcode, s, newline ] ) 


] ).


