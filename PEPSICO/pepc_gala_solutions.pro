%=======================================================================
i_rule(get_freight_line, [
%=======================================================================
  
   last_line
   
   , q(0,150,up)

  , generic_horizontal_details( [ [`Freight`, tab  ], line_net_amount, d, newline ] )

  , generic_item( [ line_descr, `Freight`] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [
              
         [ line_invoice_line, line_invoice_line1]
          
           , line

        ] ) 

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================

 or([
          
     [`Date`, tab, `Order`, `No`, tab, `Code`, `Description` ]
     
 ])

, trace( [ `Found Start line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
 
 or([

     [`Freight`, tab ]

 ])

  , trace( [ `Found End line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================

  
      generic_item( [ line_date, s1, tab ] )

   , generic_item( [ line_buyers_order_number, d, tab ] )

   , generic_item( [ line_descr, s1, newline ] )
] ).

%=======================================================================
i_line_rule_cut( line_invoice_line1, [
%=======================================================================

  
      generic_append( [ line_descr, s1, tab, `` , ` ` ] )

   , generic_item( [ line_quan_dummy, d, q10(tab) ] )

   , generic_item( [ line_quantity, d, tab ] )

   , generic_item( [ line_unit_amount, d, tab ] )

   , generic_item( [ line_net_amount, d, newline ] )

] ).


