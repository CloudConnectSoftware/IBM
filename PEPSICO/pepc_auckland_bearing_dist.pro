%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================
  
   q(0,20,line)

   , or([

      generic_horizontal_details( [ [`TAX`, `INVOICE`,q10(tab), `:`, q10(tab) ], invoice_number, d, newline ] )

  ])

] ).

