%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [

                                        
              [line_invoice_line , line_invoice_descr]
              
              
                                
              , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================
    or([
    
     [ `Item`, tab, `Material`, tab, `Quantity`, tab ]
    

    ])
   
    , trace([`found the START line`])
] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================
    or([
    
   [ `Total`, `Amount`, `Due`, tab]


    ])
     , trace([`found the END line`])

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
  
  generic_item( [ line_reference, d ] )

  , generic_item( [ line_item, d, tab] )

  , generic_item( [ line_quantity, d ] )

  , generic_item( [ line_quantity_uom_code, s1, tab ] )

 , generic_item( [ line_unit_amount, d ] )

 , generic_item( [ line_unit_code, s1, tab ] )

 , generic_item( [ line_dummy_unit, s1, tab ] )

 , generic_item( [ line_net_amount, d, [dummy(w), newline] ] )


] ).



%=======================================================================
i_line_rule_cut( line_invoice_descr, [
%=======================================================================

    q10(generic_item( [ line_descr, s1, newline ] ))

    

] ).
