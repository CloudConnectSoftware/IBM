%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% BANK ACCOUNT DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_bank_accountnumber, [
%=======================================================================

       q0n(line)

    , generic_horizontal_details( [ [ `Account`, `No`, `:` ], remit_to_bank_account_number, d, newline ] )

    , q(0,1,line)

    , generic_horizontal_details( [ [ `Swift`, `Code`, `:` ], remit_to_swift_code, s1, newline ] )

    , q(0,1,line)

    , generic_horizontal_details( [ [ `IFSC`, `Code`, `:`], remit_to_bank_code, s1, tab ] )

] ).


