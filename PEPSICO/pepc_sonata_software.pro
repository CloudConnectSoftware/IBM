%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

        sender_name( `SONATA SOFTWARE LIMITED` )

      , supplier_vat_number(`29AABCS8459D2Z1`)

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================

    q(0,10,line)

   , line_add_line

   , q(0,1,line)
   
   , line_add_line_1

   , q(0,1,line)

   , line_add_line_2
   
   , q(0,1,line)

   , line_add_line_3

   , q(0,1,line)

   , line_add_line_4

   , q(0,1,line)

   , line_add_line_5

] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

      q0n(anything)
     
    , read_ahead(`Sonata`)

    , trace( [ `Found address`] )

    , generic_item( [ supplier_party, s1, tab ] )

    , generic_item( [ supplier_party_dummy, s1, tab ] )

    , generic_item( [ supplier_party_dummy1, s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line_1, [
%=======================================================================

       generic_item( [ supplier_party_dummy2, s1, tab ] )
        
    , generic_item( [ supplier_address_line, s1 , tab ] )

    , generic_item( [ supplier_add_dummy, s1, tab ] )

    , generic_item( [ supplier_add_dummy1, s1, newline ] )

] ).


%=======================================================================
i_line_rule( line_add_line_3, [
%=======================================================================

     generic_append( [ supplier_address_line, s1, newline , ` `, ` `] )
 
] ).

%=======================================================================
i_line_rule( line_add_line_4, [
%=======================================================================
     
      generic_item( [supplier_street , s , [q10(tab), check(supplier_street(end) < -52)] ] )
          
    , generic_item( [ supplier_city, w ] )

    , generic_item( [ supplier_dummy, s1, tab  ] )

    , generic_item( [ supplier_dummy1, s1, newline  ] )

 
] ).

%=======================================================================
i_line_rule( line_add_line_5, [
%=======================================================================
     
      generic_item( [ supplier_postcode, d, `,`  ] )

    , generic_item( [ supplier_add_dummy2, s1, newline ] )
 
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% BUYER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_buyer_address, [
%=======================================================================
  
      q(0,20,line)

    , line_add_line1

    , q(0,1,line)

    , line_add_line2

    , q(0,1,line)

    , line_add_line3

    , q(0,1,line)

    , line_add_line4
] ).

%=======================================================================
i_line_rule( line_add_line1, [
%=======================================================================
    
      q0n(anything)
           
    , or([
        
      read_ahead(`Frito`)

    , read_ahead(`PepsiCo`)

] )

   , trace( [ `Found address`] )

   , generic_item( [buyer_party , s1, tab ] )

   , generic_item( [buyer_party_dummy , s1, tab ] )

   , generic_item( [buyer_party_dummy1 , s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line2, [
%=======================================================================
  
      generic_item( [buyer_party_dummy2 , s1, [tab, `:` ] ] )
    
    , generic_item( [ buyer_address_line, s1 , tab ] )

    , generic_item( [ buyer_add_dummy1, s1, newline ] )

] ).

%=======================================================================
i_line_rule( line_add_line3, [
%=======================================================================
      
      generic_item( [buyer_dummy , s , [q10(tab), check(buyer_dummy(end) < -227)] ] )
     
    , generic_item( [buyer_city , w ] )

    , generic_item( [buyer_postcode , s , [q10(tab), check(buyer_postcode(end) < -133)] ] )

    , generic_item( [ buyer_state, w, tab ] )

    , generic_item( [ buyer_add_dummy2, s1, newline ] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% REMIT TO ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_remit_address, [
%=======================================================================

    last_line
    
   , q(0,20,up)

   , line_remit_line
  
   , q(0,1,line)

   , line_remit_line2

   , q(0,1,line)

   , line_remit_line3

   , q(1,2,line)

   , line_remit_line4

] ).

%=======================================================================
i_line_rule( line_remit_line, [
%=======================================================================

      q0n(anything)
      
    , read_ahead(`Vaishnavi`)

    , trace( [ `Found address`] )


    , generic_item( [ remit_to_party, s1, newline  ] )

] ).

%=======================================================================
i_line_rule( line_remit_line2, [
%=======================================================================
 
      generic_item( [ remit_to_address_line, s1 , newline ] )
    
] ).

%=======================================================================
i_line_rule( line_remit_line3, [
%=======================================================================
 
      generic_append( [ remit_to_address_line, s1 , newline , ` `, ` `] )
    
] ).


%=======================================================================
i_line_rule( line_remit_line4, [
%=======================================================================
    
    set(regexp_allow_partial_matching)

   , generic_item( [ remit_to_city, w  ] )

   , generic_item( [ remit_to_postcode, d , newline ] )

   , clear(regexp_allow_partial_matching)

] ).


