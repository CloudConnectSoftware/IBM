% GET SUPPLIER Detail
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

	sender_name(`OMNISOURCE MARKETING GROUP`)

    ,supplier_party(`OMNISOURCE MARKETING GROUP`)

    , supplier_address_line(`8925 N. Meridian Street, Suite 150`)

    , supplier_city(`Indianapolis`)

    , supplier_state(`Indiana`)
    
    , supplier_postcode(`46260`)

    , supplier_vat_number(`N/A`)

    


