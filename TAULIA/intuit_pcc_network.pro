%=======================================================================

    sender_name( `PCC Network Solutions` )

   ,supplier_party( `PCC Network Solutions` )

   ,supplier_vat_number(`Not on Invoice`)

   ,buyer_dept(`N/A`)

   ,buyer_registration_number(`N/A`)


