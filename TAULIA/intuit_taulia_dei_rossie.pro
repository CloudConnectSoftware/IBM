%=======================================================================
i_rule( get_shipping_charges, [
%=======================================================================
  
     q(0,30,line)

   , line_shipping_line


] ).

%=======================================================================
i_line_rule( line_shipping_line, [
%=======================================================================


       read_ahead([`S`, `&`, `H`, tab, `$`])

     , trace( [ `Found address`] )

     , generic_item( [ line_descr, s1, [ tab, `$`] ] )

     , generic_item( [ line_net_amount, d, newline ] )


] ).


