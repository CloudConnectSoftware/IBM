%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_detail, [
%=======================================================================

    sender_name( `Dei Rossi Marketing` )
    
   , buyer_dept(`N/A`)

   , buyer_registration_number(`N/A`)

   , supplier_party(`Dei Rossi Marketing`)

   , supplier_street(`2150 South Central Expressway, Suite 150`)
   
   , supplier_city(`McKinney`)

   , supplier_state(`TX`)

   , supplier_postcode(`75070`)

   , supplier_country_code(`US`)

   , delivery_code(`US`)

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SUPPLIER ADDRESS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_address, [
%=======================================================================
      
    
    q(20,30,line)

   , line_add_line

   , q(0,1,line)

   , line_add_line_1

] ).

%=======================================================================
i_line_rule( line_add_line, [
%=======================================================================

       read_ahead([`Dei`, `Rossi`, `Marketing`])

     , trace( [ `Found address`] )

     , generic_item( [supplier_party , s , [q10(tab), check(supplier_party(end) < -172)] ] )

     , generic_item( [supplier_street , s , [q10(tab), check(supplier_street(end) < 86)] ] )

     , generic_item( [supplier_city , s , [q10(tab), check(supplier_city(end) < 152)] ] )

     , generic_item( [supplier_state , s , [q10(tab), check(supplier_state(end) < 172)] ] )

     , generic_item( [ supplier_dummy, s1 ] )

     , generic_item( [ supplier_postcode, d, newline ] )


] ).

%=======================================================================
i_line_rule( line_add_line1, [
%=======================================================================
   

] ).

