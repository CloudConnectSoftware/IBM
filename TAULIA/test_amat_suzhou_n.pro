%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule_cut( get_invoice_number, [
%=======================================================================

    q0n(line)

    , generic_vertical_details( [ [ `电子发票`, `（`, `增值税专用发票`, `）`,  tab], `电子发票`, q(0,1,up), (start,100,900), invoice_number_dummy, d, newline ] )
    
    , check( invoice_number_dummy = Invstripnew )

     , check( q_sys_sub_string( Invstripnew, 5, 16, Inv_new ) )

     , invoice_number(Inv_new)     

     , trace( [ `Invoice Number` , invoice_number ] )

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

       q0n(line)

   , generic_vertical_details( [ [`开票日期`, `：` ], `开票日期`, q(0,1), (start,100,900), invoice_date_dummy, s1, newline ] )

   , trace( [ `Invoice Date dummy` , invoice_date_dummy ] )

    , check( invoice_date_dummy = DateRaw )

    , check(string_string_replace( DateRaw, `年`, ` `, Dateyear ))

     , check(string_string_replace( Dateyear, `月`, ` `, Datemon ))

    , check(string_string_replace( Datemon, `日`, ``, Dated ))

    , invoice_date(Dated)

    , trace( [ `Invoice Date` , invoice_date ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  INVOICE DATE 4
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date_4, [
%=======================================================================

     q(0,40,line)

     , or([    

        generic_vertical_details( [ [`开票日期`, `：` ], `开票日期`, q(0,1), (start,100,900), invoice_date_dummy, s1, newline ] )    


     ])

     , check( invoice_date_dummy = DateRaw1 )

    , trace( [ `Invoice Date dummy` , DateRaw1  ] )

    , check(string_string_replace( DateRaw1, `年`, ` `, DateStrip1  ))
    
    , invoice_date_1(DateStrip1 )

    , check(string_string_replace( DateStrip1, `月`, ` `, DateStrip11  ))

    , invoice_date_2(DateStrip11 )

    , check(string_string_replace( DateStrip11, `日`, ``, DateStrip21  ))

    , invoice_date(DateStrip21 )

    , trace( [ `Invoice Date` , invoice_date ] )  
    
    
] ).







%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ORDER NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule_cut( get_order_number, [
%=======================================================================

     q0n(line)

  ,  find_order_number


] ).
 
%=======================================================================
i_line_rule_cut( find_order_number, [
%=======================================================================

    q0n(anything)


, or( [
            [ generic_item( [ order_number , [ begin, q(dec("4"),1,1) , q(dec("5"),1,1) , q(dec,8,10) , end ] ] ), set(order_number_45) ]

          , [ generic_item( [ order_number , [ begin, q(dec("4"),1,1) , q(dec("4"),1,1) , q(dec,8,10) , end ] ] ), set(order_number_44) ]
    ] )

 
] ).

