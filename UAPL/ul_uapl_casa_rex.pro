i_version( ul_uapl_casa_rex ,`21/03/2017` ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

i_date_format( _ ).

i_trace_lists.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
i_rule_list( [
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 
	 get_supplier_details
	          		
	, get_invoice_number
	
	, get_invoice_date

    , get_due_date

    , get_order_number
	
    , get_total_invoice
    
    , get_line_total_amount 

	, get_currency

    , get_invoice_lines
	
] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET SUPPLIER DETAILS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_supplier_details, [
%=======================================================================

	sender_name(`CASA REX PROJETOS, COMUNICACAO`)

    , set(freight_vendor)

] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

	q0n(line)
	
	, generic_horizontal_details( [ [`INVOICE`, `Nº`, `.`, tab ], invoice_number, d, newline ] )

] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

	q0n(line)
	
	, generic_horizontal_details( [ [`INVOICE`, `DATE`, `:`, tab ],  invoice_date_raw, s1, newline ] )

       , check( invoice_date_raw = DateRaw )

        , trace( [ `Invoice date raw` , DateRaw ] )

         , check(string_string_replace( DateRaw, `,`, ``, DateStrip ))

         , trace( [ `Date Stripped Coma` , DateStrip ] )

         , invoice_date(DateStrip)

         , trace( [ `Invoice Date` , invoice_date ] )



] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET DUE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_due_date, [
%=======================================================================

	q0n(line)
	
	, generic_horizontal_details( [ [ `DUE`, `DATE`, `:`, tab ],  due_date_raw, s1, newline] )

    , check( due_date_raw = DateRaw )

        , trace( [ `Due date raw` , DateRaw ] )

         , check(string_string_replace( DateRaw, `,`, ``, DateStrip ))

         , trace( [ `Date Stripped Coma` , DateStrip ] )

         , due_date(DateStrip)

         , trace( [ `Due Date` , due_date ] )


] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET ORDER NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_order_number, [
%=======================================================================

	q0n(line)
	
	, generic_horizontal_details( [ [ `DO`, `NUMBER`, `:`, tab ],  order_number, s1, newline ] )


] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET TOTAL INVOICE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_invoice, [
%=======================================================================

qn0(line)

, generic_horizontal_details( [ [ `TOTAL`, `DUE`, `:`, `EUR`, tab ],  total_invoice_raw, s1, newline ] )

, check( total_invoice_raw = InvoiceRaw )

    , trace( [ `Total Invocie raw` , InvoiceRaw ] )

    , check(string_string_replace( InvoiceRaw, `.`, ``, InvoiceStrip ))

    , trace( [ `Invoice Stripped Dot` , InvoiceStrip ] )

    , check(string_string_replace( InvoiceStrip, `,`, `.`, InvoiceStrip2 ))

    , trace( [ `Invoice Stripped Dot` , InvoiceStrip2  ] )

    , total_invoice(InvoiceStrip2)

    , trace( [ `Total Invoice` , total_invoice ] )


       , check( total_invoice = TotInv )

        , trace( [ `Total Inv` , TotInv] )

        , total_net(TotInv)

        , trace( [ `Total net` , total_net ] )



] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET LINE TOTAL AMOUNT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_line_total_amount, [
%=======================================================================

	qn0(line)
	
    , generic_horizontal_details( [ [ `TOTAL`, `DUE`, `:`, `EUR`, tab ],  line_total_amount_raw, s1, newline ] )

    , check( line_total_amount_raw = AmountRaw )

    , trace( [ `Line Total raw` , AmountRaw ] )

    , check(string_string_replace( AmountRaw, `.`, ``, AmountStrip ))

    , trace( [ `Amount Stripped Dot` , AmountStrip ] )

    , check(string_string_replace( AmountStrip, `,`, `.`, AmountStrip2 ))

    , trace( [ `Amount Stripped Dot` , AmountStrip2  ] )

    , line_total_amount(AmountStrip2)

    , trace( [ `Line Total Amount` , line_total_amount ] )


		
] ).


