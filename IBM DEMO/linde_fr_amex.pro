%=======================================================================


] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================


    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [
              
              line_description_line
              
              ,line_invoice_line 

             , line_description_line2

              ,line_invoice_line2

              ,line_description_line3

              , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================

or([

[`PNR`, `:`, tab ]


])

, trace( [ `Found Start line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================

    or([
[`Détails`, `de`, `règlement`, tab, `TOTAL`]

])

  , trace( [ `Found End line` ] )

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================


 generic_item( [ line_net_amount_dummy, d, tab ] )

 ,generic_item( [ line_vat_amount_dummy, d, tab ])

 ,generic_item( [ line_quantity, d, tab ])

,generic_item( [ line_unit_amount, d,tab ] )

,generic_item( [ line_vat_amount, d,tab ] )

,generic_item( [ line_dummy,d ] )

,generic_item( [ line_currency_dummy,w,tab ] )

,generic_item( [ line_net_amount, d] )

,generic_item( [ line_currency_dummy2,w,newline ] )


] ).

%=======================================================================
i_line_rule_cut( line_invoice_line2, [
%=======================================================================


 generic_item( [ line_net_amount_dummy, d, tab ] )

 ,generic_item( [ line_quantity, d, tab ])

,generic_item( [ line_vat_amount, d,tab ] )

,generic_item( [ line_dummy,d ] )

,generic_item( [ line_currency_dummy,w,tab ] )

,generic_item( [ line_net_amount, d] )

,generic_item( [ line_currency_dummy2,w,newline ] )


] ).

%=======================================================================
i_line_rule_cut( line_description_line, [
%=======================================================================

read_ahead(`Passager`)

 ,generic_item( [ line_descr, s1, tab ] )

 ,generic_append( [ line_descr, s1, tab, `  `, ` `  ] )

 ,generic_append( [ line_descr, s1, newline, `  `, ` `  ] )

 
] ).

%=======================================================================
i_line_rule_cut( line_description_line2, [
%=======================================================================

read_ahead(`Hotel`)

 ,generic_item( [ line_descr, s1, newline ] )

 
] ).

%=======================================================================
i_line_rule_cut( line_description_line3, [
%=======================================================================

read_ahead(`frais`)

 ,generic_item( [ line_descr, s1, newline ] )

 
] ).


