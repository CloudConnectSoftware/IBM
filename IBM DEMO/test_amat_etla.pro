%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    
      get_supplier_detail
    , get_invoice_number
    , get_invoice_date
    , get_total_invoice
    , get_exchange_rate
    , get_currency

