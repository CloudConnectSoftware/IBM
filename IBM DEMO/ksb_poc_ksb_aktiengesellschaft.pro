%=======================================================================
i_rule( get_order_number, [
%=======================================================================

    q(0,50,line)

    , generic_horizontal_details( [ [`Ihre`, `Bestellung`, `:` ], order_number, s, [q10( `MTU`) ,`vom`] ] )

] ).

