%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE CURRENCY
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_currency, [
%=======================================================================

     q(0,150,line)

   ,generic_horizontal_details( [ [`TOTAL`],  currency, w, [`:`, tab ] ] )


] ).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GET INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================


    line_header_line

    , qn0( [ peek_fails(line_end_line)

        , or( [
              
              [line_invoice_line,q10(line_desc_line),q10(line_append_line),q10(line_append_line),q10(line_append_line),
              q10(line_append_line),q10(line_po_line),q10(line_append_last_line)]

              , line

        ] )

    ] )

] ).

%=======================================================================
i_line_rule_cut( line_header_line, [
%=======================================================================


[`Order`, `No`, `.`]

, trace( [ `Found Start line` ] )

] ).

%=======================================================================
i_line_rule_cut( line_end_line, [
%=======================================================================

  or([
  
    [`Bank`, `Details`, `BNP`]

    ,[`Payment`, `conditions`]

    ,[`NET`, `TOTAL`]

  ])

  , trace( [ `Found End line` ] )

] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================

  generic_item( [ line_item, w ] )

, generic_item( [ line_descr, s1, tab ] )


, generic_item( [ line_delivery_note_number, w, tab ] )

, generic_item( [ line_quantity_dummy, w, tab ] )

, set(regexp_cross_word_boundaries)

, generic_item( [ line_unit_amount, d, tab ] )

, generic_item( [ line_net_amount, d, newline ] )

, clear(regexp_cross_word_boundaries)


] ).
%=======================================================================
i_line_rule_cut( line_desc_line, [
%=======================================================================

     generic_append( [ line_descr, s1, tab, `_`, ``  ] )

    ,generic_item( [ line_delivery_date, date, newline ] )  

     
 
] ).

%=======================================================================
i_line_rule_cut( line_append_line, [
%=======================================================================

   generic_append( [ line_descr, s1, newline, `_`, ``  ] )


] ).

%=======================================================================
i_line_rule_cut( line_po_line, [
%=======================================================================

    `Your`, `order`, `:`

    ,generic_item( [ line_buyers_order_number, w, newline ] )

] ).

%=======================================================================
i_line_rule_cut( line_append_last_line, [
%=======================================================================

   generic_append( [ line_descr, s1, tab, `_`, ``  ] )

  ,generic_append( [ line_descr, s1, tab, `_`, ``  ] )

  ,generic_append( [ line_descr, s1, newline, `_`, ``  ] )


] ).


