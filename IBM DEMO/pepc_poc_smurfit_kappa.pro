%=======================================================================
i_rule(get_total_invoice, [
%=======================================================================

   q(0,150,line)

  , set(regexp_cross_word_boundaries)

  ,generic_horizontal_details( [ [`TOTAL`, `EUR`, `:`, tab ],  total_invoice, d, newline ] )

