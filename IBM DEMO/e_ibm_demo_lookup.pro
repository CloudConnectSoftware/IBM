% COST CENTRE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_sender_name, [
%=======================================================================

    q(0,40,line)

    , generic_horizontal_details( [ [ `Sender`, `Name` ], 200, sender_name, s1, newline ] )

    , check( i_user_check( lookup_cost_centre, sender_name, CC ) )

    , generic_item( [ cost_centre, CC ] )

] ).

%=======================================================================
i_user_check( lookup_cost_centre, Name, CC )
%-----------------------------------------------------------------------
:-
    % Can add manipulations here to clean up value
    string_to_upper( Name, NameU ),

    name_to_cost_centre( NameU, CC )
.
%=======================================================================

name_to_cost_centre( `Anne`, `12345678` ).
name_to_cost_centre( `Jack`, `23654258` ).
name_to_cost_centre( `Steve`, `12422255` ).