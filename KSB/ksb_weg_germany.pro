      ,  or([  
          
        generic_horizontal_details( [ [ `Netto`, tab ],  total_net, d, newline ] )

           ])

      , clear(reverse_punctuation_in_numbers)   , clear(regexp_cross_word_boundaries)

  

        
] ).


