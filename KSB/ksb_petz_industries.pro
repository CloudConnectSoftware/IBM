%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

 q(0,20,line)
	
   ,  or([
           
         generic_horizontal_details( [ [`RECHNUNG`  ], invoice_number, s1, newline ] )

         ])
] ).



