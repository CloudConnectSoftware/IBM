%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

q(0,15,line)
	
   ,  or([
           
           generic_horizontal_details( [ [ `Nr`, `.`, `:`], invoice_number, s1, tab ] )

        ])
] ).


