i_rule( get_invoice_number, [
%=======================================================================

q(0,10,line)
	
   ,  or([
            generic_horizontal_details( [ [ `Rechnung`, `-`, `Nr`, `.`, `:` ], invoice_number, d, `(` ] )

        ])
] ).


