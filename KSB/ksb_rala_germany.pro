i_rule( get_delivery_note_number, [
%=======================================================================
q(0,50,line)
	
	, generic_horizontal_details( [ [ `Lieferschein`, `-`, `Nr`, `.`, `:`], delivery_note_number, d, `VOM` ] )
] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
