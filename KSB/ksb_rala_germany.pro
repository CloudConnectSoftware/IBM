%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

q(0,50,line)
	
   ,  or([
       
	  generic_horizontal_details( [[`Rechnung`, `Nr`, `.`, `:` ], invoice_number, w, tab ] )

   

    ])
] ).

