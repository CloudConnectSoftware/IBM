%=======================================================================
i_rule( get_invoice_number, [
%=======================================================================

 q(0,20,line)
	
   ,  or([
           
        generic_horizontal_details( [ [`Rechnung`, `-` ], invoice_number, s1, tab ] )

         ])
] ).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  INVOICE DATE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_invoice_date, [
%=======================================================================

 q(0,20,line)
	
   ,  or([
           
          generic_horizontal_details( [ [`Rechnungsdat`, `.`, tab ], invoice_date, date, newline ] )


         ])
] ).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  ORDER NUMBER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_order_number, [
%=======================================================================

    q(0,50,line)

    , or([
      
      generic_horizontal_details( [ [ `Best`, `Nr` ], order_number, d, `/` ] )

    ,  find_order_number

   ])

] ).


%=======================================================================
i_line_rule_cut( find_order_number, [
%=======================================================================

    q0n(anything)

    , or([
        generic_item( [ order_number , [ begin, q(dec("4"),1,1) , q(dec("5"),1,1) , q(dec,8,10) , end ] ] )

    ])

]).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE NET
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_net_amount, [
%=======================================================================

	qn0(line)

    

    , [set(reverse_punctuation_in_numbers)

    , set(regexp_cross_word_boundaries)

     ,or([

       generic_horizontal_details( [ [`Total`, generic_item( [ currency, w ] ), `ohne`, `MwSt`, `.`, tab ], total_net, d,newline ] )

        ])


    , clear(reverse_punctuation_in_numbers)

    , clear(regexp_cross_word_boundaries)]

    
    


	
]).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  TOTAL  VAT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_vat, [
%=======================================================================

qn0(line)



    , [set(reverse_punctuation_in_numbers)

    , set(regexp_cross_word_boundaries)

     ,or([

         generic_horizontal_details( [ [ `19`, `%`, `MwSt`, `.`, tab ], total_vat, d, newline ] )
       

             ])
        , generic_item( [ default_vat_rate,`19` ] )


    , clear(reverse_punctuation_in_numbers)

    , clear(regexp_cross_word_boundaries)]


]).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INVOICE TOTAL
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_rule( get_total_invoice, [
%=======================================================================

	q0n(line)

  

    , [set(reverse_punctuation_in_numbers)

    , set(regexp_cross_word_boundaries)

     ,or([

           generic_horizontal_details( [ [`Total`, `EUR`, `inkl`, `.`, `MwSt`, `.`, tab ], total_invoice,d, newline ] )

        ])


    , clear(reverse_punctuation_in_numbers)

    , clear(regexp_cross_word_boundaries)]
	
]).



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  INVOICE LINES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%=======================================================================
i_section( get_invoice_lines, [
%=======================================================================

	line_start_line
	
	,qn0( [ peek_fails(line_end_line)
		
		,or( [

            		
		 [q10(line_dummy_line),q10(line_po_line),line_invoice_line]
             
			, line

			
			
		] )
	
	] )

] ).


%=======================================================================
i_line_rule_cut( line_start_line,[
%=======================================================================
	
	or([

        [`Nr`, `.`, tab, `Beschreibung`, tab, `Menge` ]
      
      ])

    , trace([`found the start line`])

] ).

%=======================================================================
i_line_rule_cut( line_end_line,[
%=======================================================================

	  or([

          [`Total`, `EUR`, `ohne`, `MwSt`, `.`, tab ]

          , [`Nr`, `.`, tab, `Beschreibung`, tab, `Menge` ]


        ])

        , trace([`found the end line`])
    
] ).


%=======================================================================
i_line_rule_cut( line_invoice_line, [
%=======================================================================
	       
            
       set(regexp_cross_word_boundaries)

      , set(reverse_punctuation_in_numbers)

      , generic_item( [ line_item,s,  [q10(tab), check(line_item(end) < -210)] ] )

      , generic_item( [ line_descr, s1, tab ] )

      , generic_item( [ line_quantity, d, [ q10(a(w)), tab] ] )

      , generic_item( [ line_unit_amount, d, tab ] )

      , generic_item( [ line_net_amount,d, newline ] )



       , clear(reverse_punctuation_in_numbers)

       , clear(regexp_cross_word_boundaries)

    
] ).

%=======================================================================
i_line_rule( line_po_line, [
%=======================================================================
	
       
            
       `Best`, `Nr`

       , generic_item( [ line_buyers_order_number,d, `/` ] )

      , generic_item( [ line_order_amount,s1, newline ] )


    
] ).

%=======================================================================
i_line_rule( line_dummy_line, [
%=======================================================================
	
       
            
       generic_item( [ line_dummy,s1, newline ] )


    
] ).


